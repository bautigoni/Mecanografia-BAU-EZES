# Dependencies
node_modules

# Build output
dist
dist-ssr
*.tsbuildinfo

# Local env — NEVER commit real secrets / API keys.
# Only .env.example is allowed in git.
.env
.env.local
.env.*.local

# Editor / OS clutter
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Caches
.cache
.tmp

# Claude/agent scratch
.claude

# Local asset backups (not shipped)
_backups/

# Skin source PNGs — only the optimised .webp siblings are shipped/tracked.
# Regenerate the .webp with sharp/optimize_images.py after dropping new PNGs.
public/assets/edutic-art/skins/*.png

# Local verification scratch (Playwright screenshots, dev scripts)
screenshots/

# Salida del preview de posiciones de nivel (scripts/preview-level-positions.mjs)
.preview-niveles/
